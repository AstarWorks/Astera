{
  "format_version": "1.0",
  "name": "noise_aura",
  "size": [32, 32],
  "frames": 16,
  "frame_time_ticks": 3,
  "loop": true,
  "nodes": [
    {
      "id": "noise",
      "type": "noise.perlin",
      "params": { "scale": 6, "seed": 1, "octaves": 4 },
      "pos": { "x": 60, "y": 40 }
    },
    {
      "id": "ring_mask",
      "type": "shape.ring",
      "params": { "cx": 16, "cy": 16, "radius": 11, "thickness": 6, "color": "#ffffff" },
      "pos": { "x": 60, "y": 220 }
    },
    {
      "id": "masked",
      "type": "composite.multiply",
      "params": {},
      "pos": { "x": 320, "y": 120 }
    },
    {
      "id": "palette",
      "type": "filter.palette",
      "params": { "colors": 6 },
      "pos": { "x": 560, "y": 120 }
    },
    {
      "id": "spin",
      "type": "anim.rotate",
      "params": { "speed_deg_per_sec": 18, "origin": [16, 16] },
      "pos": { "x": 800, "y": 120 }
    },
    {
      "id": "bloom",
      "type": "filter.bloom",
      "params": {
        "threshold": 0.4,
        "radius": 2,
        "intensity": 1.1,
        "saturation": 1.3,
        "color": "#86efac"
      },
      "pos": { "x": 1040, "y": 120 }
    },
    { "id": "out", "type": "output", "params": {}, "pos": { "x": 1280, "y": 120 } }
  ],
  "edges": [
    { "from": "noise", "to": "masked", "in": "a" },
    { "from": "ring_mask", "to": "masked", "in": "b" },
    { "from": "masked", "to": "palette", "in": "image" },
    { "from": "palette", "to": "spin", "in": "image" },
    { "from": "spin", "to": "bloom", "in": "image" },
    { "from": "bloom", "to": "out", "in": "image" }
  ]
}
