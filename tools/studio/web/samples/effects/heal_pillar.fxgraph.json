{
  "format_version": "1.0",
  "name": "heal_pillar",
  "size": [32, 32],
  "frames": 16,
  "frame_time_ticks": 1,
  "loop": true,
  "nodes": [
    {
      "id": "wind",
      "type": "particle.effector",
      "params": {
        "mode": "wind",
        "origin": [16, 16],
        "strength": 0.02,
        "radius": 24,
        "falloff": "linear"
      },
      "pos": { "x": 40, "y": 40 }
    },
    {
      "id": "rising",
      "type": "particle.emitter",
      "params": {
        "count": 30,
        "spawn_origin": [16, 28],
        "spawn_radius": 6,
        "spawn_mode": "continuous",
        "velocity_min": 0.4,
        "velocity_max": 0.9,
        "velocity_direction": "angle",
        "velocity_angle_deg": -90,
        "lifetime_frames": 16,
        "size_start": 1.8,
        "size_end": 0.3,
        "shape": "dot",
        "gradient": [
          { "t": 0, "color": "#ffffff" },
          { "t": 0.3, "color": "#fef08a" },
          { "t": 0.7, "color": "#fbbf24" },
          { "t": 1, "color": "#00000000" }
        ],
        "seed": 5
      },
      "pos": { "x": 320, "y": 40 }
    },

    {
      "id": "outline",
      "type": "filter.outline",
      "params": {
        "thickness": 1,
        "color": "#7c2d12",
        "mode": "outside"
      },
      "pos": { "x": 620, "y": 40 }
    },

    {
      "id": "dither",
      "type": "filter.dither",
      "params": {
        "palette_size": 4,
        "pattern": "bayer4"
      },
      "pos": { "x": 880, "y": 40 }
    },

    {
      "id": "bloom",
      "type": "filter.bloom",
      "params": {
        "threshold": 0.4,
        "radius": 3,
        "intensity": 1.1,
        "saturation": 1.4,
        "color": "#fde047"
      },
      "pos": { "x": 1140, "y": 40 }
    },
    { "id": "out", "type": "output", "params": {}, "pos": { "x": 1400, "y": 40 } }
  ],
  "edges": [
    { "from": "wind", "to": "rising", "in": "effector" },
    { "from": "rising", "to": "outline", "in": "image" },
    { "from": "outline", "to": "dither", "in": "image" },
    { "from": "dither", "to": "bloom", "in": "image" },
    { "from": "bloom", "to": "out", "in": "image" }
  ]
}
