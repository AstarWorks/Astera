{
  "format_version": "1.0",
  "name": "lightning_arc",
  "size": [32, 32],
  "frames": 12,
  "frame_time_ticks": 1,
  "loop": true,
  "nodes": [
    {
      "id": "wiggle_x",
      "type": "anim.wiggler",
      "params": {
        "frequency": 6.0,
        "amplitude": 3.5,
        "center": 16,
        "seed": 11
      },
      "pos": { "x": 40, "y": 40 }
    },

    {
      "id": "bolt_seg1",
      "type": "shape.line",
      "params": {
        "x0": 16, "y0": 1,
        "x1": 13, "y1": 8,
        "thickness": 1.5,
        "color": "#ffffff"
      },
      "pos": { "x": 320, "y": 40 }
    },
    {
      "id": "bolt_seg2",
      "type": "shape.line",
      "params": {
        "x0": 13, "y0": 8,
        "x1": 19, "y1": 14,
        "thickness": 1.5,
        "color": "#dbeafe"
      },
      "pos": { "x": 320, "y": 160 }
    },
    {
      "id": "bolt_seg3",
      "type": "shape.line",
      "params": {
        "x0": 19, "y0": 14,
        "x1": 14, "y1": 20,
        "thickness": 1.5,
        "color": "#bfdbfe"
      },
      "pos": { "x": 320, "y": 280 }
    },
    {
      "id": "bolt_seg4",
      "type": "shape.line",
      "params": {
        "x0": 14, "y0": 20,
        "x1": 18, "y1": 26,
        "thickness": 1.5,
        "color": "#a5b4fc"
      },
      "pos": { "x": 320, "y": 400 }
    },
    {
      "id": "bolt_seg5",
      "type": "shape.line",
      "params": {
        "x0": 18, "y0": 26,
        "x1": 16, "y1": 31,
        "thickness": 1.5,
        "color": "#c4b5fd"
      },
      "pos": { "x": 320, "y": 520 }
    },

    {
      "id": "bolt_combine_a",
      "type": "composite.add",
      "params": {},
      "pos": { "x": 600, "y": 100 }
    },
    {
      "id": "bolt_combine_b",
      "type": "composite.add",
      "params": {},
      "pos": { "x": 820, "y": 220 }
    },
    {
      "id": "bolt_combine_c",
      "type": "composite.add",
      "params": {},
      "pos": { "x": 1040, "y": 340 }
    },
    {
      "id": "bolt_combine_d",
      "type": "composite.add",
      "params": {},
      "pos": { "x": 1260, "y": 460 }
    },

    {
      "id": "vertical_band",
      "type": "shape.line",
      "params": {
        "x0": 16, "y0": 0,
        "x1": 16, "y1": 32,
        "thickness": 7,
        "color": "#ffffff"
      },
      "pos": { "x": 40, "y": 720 }
    },
    {
      "id": "sparks",
      "type": "generate.scatter",
      "params": {
        "count": 16,
        "shape": "star",
        "size_min": 0.5,
        "size_max": 1.25,
        "color": "#a5f3fc",
        "seed": 23
      },
      "pos": { "x": 320, "y": 720 }
    },

    {
      "id": "bolt_with_sparks",
      "type": "composite.add",
      "params": {},
      "pos": { "x": 1480, "y": 540 }
    },

    {
      "id": "outline",
      "type": "filter.outline",
      "params": {
        "thickness": 1,
        "color": "#1e1b4b",
        "mode": "outside"
      },
      "pos": { "x": 1700, "y": 540 }
    },
    {
      "id": "dither",
      "type": "filter.dither",
      "params": {
        "palette_size": 4,
        "pattern": "bayer4"
      },
      "pos": { "x": 1920, "y": 540 }
    },
    {
      "id": "bloom",
      "type": "filter.bloom",
      "params": {
        "threshold": 0.35,
        "radius": 2,
        "intensity": 1.1,
        "saturation": 1.3,
        "color": "#c4b5fd"
      },
      "pos": { "x": 2140, "y": 540 }
    },
    { "id": "out", "type": "output", "params": {}, "pos": { "x": 2360, "y": 540 } }
  ],
  "edges": [
    { "from": "wiggle_x", "to": "bolt_seg3", "in": "x0" },

    { "from": "bolt_seg1", "to": "bolt_combine_a", "in": "a" },
    { "from": "bolt_seg2", "to": "bolt_combine_a", "in": "b" },
    { "from": "bolt_combine_a", "to": "bolt_combine_b", "in": "a" },
    { "from": "bolt_seg3", "to": "bolt_combine_b", "in": "b" },
    { "from": "bolt_combine_b", "to": "bolt_combine_c", "in": "a" },
    { "from": "bolt_seg4", "to": "bolt_combine_c", "in": "b" },
    { "from": "bolt_combine_c", "to": "bolt_combine_d", "in": "a" },
    { "from": "bolt_seg5", "to": "bolt_combine_d", "in": "b" },

    { "from": "vertical_band", "to": "sparks", "in": "mask" },

    { "from": "bolt_combine_d", "to": "bolt_with_sparks", "in": "a" },
    { "from": "sparks", "to": "bolt_with_sparks", "in": "b" },

    { "from": "bolt_with_sparks", "to": "outline", "in": "image" },
    { "from": "outline", "to": "dither", "in": "image" },
    { "from": "dither", "to": "bloom", "in": "image" },
    { "from": "bloom", "to": "out", "in": "image" }
  ]
}
