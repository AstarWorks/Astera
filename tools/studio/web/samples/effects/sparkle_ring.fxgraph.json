{
  "format_version": "1.0",
  "name": "sparkle_ring",
  "size": [32, 32],
  "frames": 16,
  "frame_time_ticks": 2,
  "loop": true,
  "nodes": [
    {
      "id": "ring",
      "type": "shape.ring",
      "params": {
        "cx": 16,
        "cy": 16,
        "radius": 12,
        "thickness": 2,
        "color": "#ffe14a"
      },
      "pos": { "x": 60, "y": 80 }
    },
    {
      "id": "spin",
      "type": "anim.rotate",
      "params": {
        "speed_deg_per_sec": 90,
        "origin": [16, 16]
      },
      "pos": { "x": 320, "y": 80 }
    },
    {
      "id": "bloom",
      "type": "filter.bloom",
      "params": {
        "threshold": 0.3,
        "radius": 3,
        "intensity": 1.0,
        "saturation": 1.2,
        "color": "#fff7c2"
      },
      "pos": { "x": 580, "y": 80 }
    },
    {
      "id": "out",
      "type": "output",
      "params": {},
      "pos": { "x": 840, "y": 80 }
    }
  ],
  "edges": [
    { "from": "ring", "to": "spin", "in": "image" },
    { "from": "spin", "to": "bloom", "in": "image" },
    { "from": "bloom", "to": "out", "in": "image" }
  ]
}
