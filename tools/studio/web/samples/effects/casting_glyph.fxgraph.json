{
  "format_version": "1.0",
  "name": "casting_glyph",
  "size": [32, 32],
  "frames": 24,
  "frame_time_ticks": 2,
  "loop": true,
  "nodes": [
    {
      "id": "hex",
      "type": "shape.polygon",
      "params": {
        "cx": 16,
        "cy": 16,
        "radius": 11,
        "sides": 6,
        "rotation_deg": 0,
        "color": "#8b5cf6"
      },
      "pos": { "x": 60, "y": 40 }
    },
    {
      "id": "inner",
      "type": "shape.polygon",
      "params": {
        "cx": 16,
        "cy": 16,
        "radius": 6,
        "sides": 3,
        "rotation_deg": 180,
        "color": "#c084fc"
      },
      "pos": { "x": 60, "y": 200 }
    },
    {
      "id": "combine",
      "type": "composite.add",
      "params": {},
      "pos": { "x": 320, "y": 120 }
    },
    {
      "id": "spin",
      "type": "anim.rotate",
      "params": { "speed_deg_per_sec": 30, "origin": [16, 16] },
      "pos": { "x": 560, "y": 120 }
    },
    {
      "id": "bloom",
      "type": "filter.bloom",
      "params": {
        "threshold": 0.25,
        "radius": 3,
        "intensity": 1.3,
        "saturation": 1.5,
        "color": "#d8b4fe"
      },
      "pos": { "x": 800, "y": 120 }
    },
    { "id": "out", "type": "output", "params": {}, "pos": { "x": 1040, "y": 120 } }
  ],
  "edges": [
    { "from": "hex", "to": "combine", "in": "a" },
    { "from": "inner", "to": "combine", "in": "b" },
    { "from": "combine", "to": "spin", "in": "image" },
    { "from": "spin", "to": "bloom", "in": "image" },
    { "from": "bloom", "to": "out", "in": "image" }
  ]
}
