{
  "format_version": "1.0",
  "name": "hit_flash",
  "size": [32, 32],
  "frames": 8,
  "frame_time_ticks": 1,
  "loop": true,
  "nodes": [
    {
      "id": "flash",
      "type": "shape.circle",
      "params": { "cx": 16, "cy": 16, "radius": 4, "color": "#fff5b8" },
      "pos": { "x": 60, "y": 80 }
    },
    {
      "id": "pulse",
      "type": "anim.scale_pulse",
      "params": { "min": 0.3, "max": 2.5, "period_seconds": 0.4 },
      "pos": { "x": 320, "y": 80 }
    },
    {
      "id": "bloom",
      "type": "filter.bloom",
      "params": {
        "threshold": 0.2,
        "radius": 5,
        "intensity": 1.6,
        "saturation": 1.4,
        "color": "#ffe070"
      },
      "pos": { "x": 580, "y": 80 }
    },
    { "id": "out", "type": "output", "params": {}, "pos": { "x": 840, "y": 80 } }
  ],
  "edges": [
    { "from": "flash", "to": "pulse", "in": "image" },
    { "from": "pulse", "to": "bloom", "in": "image" },
    { "from": "bloom", "to": "out", "in": "image" }
  ]
}
