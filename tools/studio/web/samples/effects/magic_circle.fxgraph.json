{
  "format_version": "1.0",
  "name": "magic_circle",
  "size": [64, 64],
  "frames": 48,
  "frame_time_ticks": 2,
  "loop": true,
  "nodes": [
    {
      "id": "spoke_base",
      "type": "generate.gradient_radial",
      "params": {
        "cx": 32, "cy": 32, "inner_radius": 4, "outer_radius": 30,
        "color_inner": "#fbbf24", "color_outer": "#00000000"
      },
      "pos": { "x": 40, "y": 40 }
    },
    {
      "id": "spokes",
      "type": "xform.polar",
      "params": { "mode": "to_cartesian", "origin": [32, 32], "twist_deg": 0 },
      "pos": { "x": 300, "y": 40 }
    },
    {
      "id": "spokes_spin",
      "type": "anim.rotate",
      "params": { "speed_deg_per_sec": 14, "origin": [32, 32] },
      "pos": { "x": 560, "y": 40 }
    },

    {
      "id": "ring_outer",
      "type": "shape.ring",
      "params": { "cx": 32, "cy": 32, "radius": 28, "thickness": 1, "color": "#8b5cf6" },
      "pos": { "x": 40, "y": 220 }
    },
    {
      "id": "ring_mid",
      "type": "shape.ring",
      "params": { "cx": 32, "cy": 32, "radius": 20, "thickness": 1, "color": "#c084fc" },
      "pos": { "x": 40, "y": 320 }
    },
    {
      "id": "ring_inner",
      "type": "shape.ring",
      "params": { "cx": 32, "cy": 32, "radius": 12, "thickness": 1, "color": "#a78bfa" },
      "pos": { "x": 40, "y": 420 }
    },
    {
      "id": "core_glyph",
      "type": "shape.polygon",
      "params": {
        "cx": 32, "cy": 32, "radius": 7, "sides": 5, "rotation_deg": 0,
        "color": "#fbbf24"
      },
      "pos": { "x": 40, "y": 520 }
    },
    {
      "id": "rings_combine_a",
      "type": "composite.over",
      "params": {},
      "pos": { "x": 320, "y": 280 }
    },
    {
      "id": "rings_combine_b",
      "type": "composite.over",
      "params": {},
      "pos": { "x": 540, "y": 360 }
    },
    {
      "id": "rings_with_glyph",
      "type": "composite.over",
      "params": {},
      "pos": { "x": 760, "y": 440 }
    },
    {
      "id": "geom_spin",
      "type": "anim.rotate",
      "params": { "speed_deg_per_sec": -10, "origin": [32, 32] },
      "pos": { "x": 980, "y": 440 }
    },

    {
      "id": "dot_mask",
      "type": "shape.ring",
      "params": {
        "cx": 32, "cy": 32, "radius": 24, "thickness": 5, "color": "#ffffff"
      },
      "pos": { "x": 40, "y": 680 }
    },
    {
      "id": "dots",
      "type": "generate.scatter",
      "params": {
        "count": 28, "shape": "star", "size_min": 0.8, "size_max": 1.4,
        "color": "#fde68a", "seed": 7
      },
      "pos": { "x": 300, "y": 680 }
    },
    {
      "id": "dots_spin",
      "type": "anim.rotate",
      "params": { "speed_deg_per_sec": 8, "origin": [32, 32] },
      "pos": { "x": 560, "y": 680 }
    },

    {
      "id": "layer_a",
      "type": "composite.add",
      "params": {},
      "pos": { "x": 1240, "y": 240 }
    },
    {
      "id": "layer_b",
      "type": "composite.add",
      "params": {},
      "pos": { "x": 1460, "y": 440 }
    },
    {
      "id": "bloom",
      "type": "filter.bloom",
      "params": {
        "threshold": 0.4, "radius": 2, "intensity": 0.8, "saturation": 1.3,
        "color": "#d8b4fe"
      },
      "pos": { "x": 1680, "y": 440 }
    },
    { "id": "out", "type": "output", "params": {}, "pos": { "x": 1920, "y": 440 } }
  ],
  "edges": [
    { "from": "spoke_base", "to": "spokes", "in": "image" },
    { "from": "spokes", "to": "spokes_spin", "in": "image" },

    { "from": "ring_outer", "to": "rings_combine_a", "in": "a" },
    { "from": "ring_mid", "to": "rings_combine_a", "in": "b" },
    { "from": "rings_combine_a", "to": "rings_combine_b", "in": "a" },
    { "from": "ring_inner", "to": "rings_combine_b", "in": "b" },
    { "from": "rings_combine_b", "to": "rings_with_glyph", "in": "a" },
    { "from": "core_glyph", "to": "rings_with_glyph", "in": "b" },
    { "from": "rings_with_glyph", "to": "geom_spin", "in": "image" },

    { "from": "dot_mask", "to": "dots", "in": "mask" },
    { "from": "dots", "to": "dots_spin", "in": "image" },

    { "from": "spokes_spin", "to": "layer_a", "in": "a" },
    { "from": "geom_spin", "to": "layer_a", "in": "b" },
    { "from": "layer_a", "to": "layer_b", "in": "a" },
    { "from": "dots_spin", "to": "layer_b", "in": "b" },
    { "from": "layer_b", "to": "bloom", "in": "image" },
    { "from": "bloom", "to": "out", "in": "image" }
  ]
}
