{
  "format_version": "1.0",
  "name": "swirl_aura",
  "size": [32, 32],
  "frames": 24,
  "frame_time_ticks": 2,
  "loop": true,
  "nodes": [
    {
      "id": "particles",
      "type": "particle.emitter",
      "params": {
        "count": 40,
        "spawn_origin": [16, 16],
        "spawn_radius": 11,
        "spawn_mode": "continuous",
        "velocity_min": 0.2,
        "velocity_max": 0.6,
        "velocity_direction": "random",
        "velocity_angle_deg": 0,
        "lifetime_frames": 18,
        "size_start": 1.6,
        "size_end": 0.3,
        "shape": "dot",
        "gradient": [
          { "t": 0, "color": "#67e8f9" },
          { "t": 0.4, "color": "#38bdf8" },
          { "t": 0.8, "color": "#3b82f6" },
          { "t": 1, "color": "#00000000" }
        ],
        "seed": 11
      },
      "pos": { "x": 60, "y": 80 }
    },
    {
      "id": "vortex",
      "type": "particle.effector",
      "params": {
        "mode": "vortex",
        "origin": [16, 16],
        "strength": 0.35,
        "radius": 14,
        "falloff": "linear"
      },
      "pos": { "x": 60, "y": 320 }
    },
    {
      "id": "trail",
      "type": "filter.trail",
      "params": { "decay": 0.78, "mode": "over" },
      "pos": { "x": 380, "y": 200 }
    },
    {
      "id": "bloom",
      "type": "filter.bloom",
      "params": {
        "threshold": 0.35,
        "radius": 3,
        "intensity": 1.1,
        "saturation": 1.3,
        "color": "#bae6fd"
      },
      "pos": { "x": 640, "y": 200 }
    },
    { "id": "out", "type": "output", "params": {}, "pos": { "x": 900, "y": 200 } }
  ],
  "edges": [
    { "from": "vortex", "to": "particles", "in": "effector" },
    { "from": "particles", "to": "trail", "in": "image" },
    { "from": "trail", "to": "bloom", "in": "image" },
    { "from": "bloom", "to": "out", "in": "image" }
  ]
}
