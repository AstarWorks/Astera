{
  "format_version": "1.0",
  "name": "energy_wave",
  "size": [32, 32],
  "frames": 12,
  "frame_time_ticks": 2,
  "loop": true,
  "nodes": [
    {
      "id": "ring",
      "type": "shape.ring",
      "params": { "cx": 16, "cy": 16, "radius": 8, "thickness": 2, "color": "#22d3ee" },
      "pos": { "x": 60, "y": 80 }
    },
    {
      "id": "expand",
      "type": "anim.scale_pulse",
      "params": { "min": 0.4, "max": 1.8, "period_seconds": 1.2 },
      "pos": { "x": 320, "y": 80 }
    },
    {
      "id": "bloom",
      "type": "filter.bloom",
      "params": {
        "threshold": 0.3,
        "radius": 4,
        "intensity": 1.3,
        "saturation": 1.6,
        "color": "#67e8f9"
      },
      "pos": { "x": 580, "y": 80 }
    },
    { "id": "out", "type": "output", "params": {}, "pos": { "x": 840, "y": 80 } }
  ],
  "edges": [
    { "from": "ring", "to": "expand", "in": "image" },
    { "from": "expand", "to": "bloom", "in": "image" },
    { "from": "bloom", "to": "out", "in": "image" }
  ]
}
