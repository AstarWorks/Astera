{
  "name": "@astera/studio",
  "version": "0.3.0",
  "type": "module",
  "description": "Astera Studio — browser UI for texture pipeline (/textures), 3D model editor (/models), pixel FX studio (/effects), and weapon-content preview (/weapons). Dev-only LLM-collaboration IDE for Minecraft content authoring; runs against any project that follows the content/ layout convention.",
  "license": "MIT",
  "author": "Astera contributors",
  "homepage": "https://github.com/AstarWorks/Astera",
  "repository": {
    "type": "git",
    "url": "https://github.com/AstarWorks/Astera.git",
    "directory": "tools/studio/web"
  },
  "keywords": [
    "minecraft",
    "paper",
    "mcmodel",
    "texture-editor",
    "pixel-art",
    "llm",
    "claude",
    "codex",
    "content-authoring",
    "vue",
    "three.js",
    "hono",
    "bun"
  ],
  "scripts": {
    "predev": "bun run scripts/kill-ports.ts",
    "dev": "concurrently -k -n vite,api -c blue,green \"bun run dev:vite\" \"bun run dev:api\"",
    "dev:vite": "vite",
    "dev:api": "bun server/index.ts",
    "kill-ports": "bun run scripts/kill-ports.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "fetch:vanilla": "bun run scripts/fetch-vanilla.ts",
    "studio": "bun run scripts/cli.ts",
    "verify:wave2": "bun run scripts/verify-wave2.ts",
    "verify:wave3": "bun run scripts/verify-wave3.ts",
    "test:snapshot": "bun test/render-snapshot.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/canvas": "^1.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/unzipper": "^0.10.11",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/core": "^1.42.5",
    "@vue-flow/minimap": "^1.5.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-json-patch": "^3.1.1",
    "hono": "^4.6.14",
    "js-yaml": "^4.1.1",
    "three": "^0.184.0",
    "unzipper": "^0.12.3",
    "vue": "^3.5.13",
    "vue-router": "^5.0.7",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "gifenc": "^1.0.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
