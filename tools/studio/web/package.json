    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/canvas": "^1.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/unzipper": "^0.10.11",
    "@vue-flow/background": "^1.3.2",
