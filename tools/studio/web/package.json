{
  "name": "@astera/studio",
  "version": "0.4.0",
  "type": "module",
  "private": true,
  "description": "Astera Studio — Nuxt 4 SPA + Nitro server on Bun. Browser UI for texture pipeline (/textures), 3D model editor (/models), pixel FX studio (/effects). Dev-only LLM-collaboration IDE for Minecraft content authoring; runs against any project that follows the content/ layout convention.",
  "license": "MIT",
  "author": "Astera contributors",
  "homepage": "https://github.com/AstarWorks/Astera",
  "repository": {
    "type": "git",
    "url": "https://github.com/AstarWorks/Astera.git",
    "directory": "tools/studio/web"
  },
  "keywords": [
    "minecraft",
    "paper",
    "mcmodel",
    "texture-editor",
    "pixel-art",
    "llm",
    "claude",
    "codex",
    "content-authoring",
    "vue",
    "nuxt",
    "nitro",
    "three.js",
    "bun"
  ],
  "scripts": {
    "predev": "bun run scripts/kill-ports.ts",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "kill-ports": "bun run scripts/kill-ports.ts",
    "typecheck": "nuxt typecheck",
    "fetch:vanilla": "bun run scripts/fetch-vanilla.ts",
    "studio": "bun run scripts/cli.ts",
    "verify:wave2": "bun run scripts/verify-wave2.ts",
    "verify:wave3": "bun run scripts/verify-wave3.ts",
    "test": "bun test server/",
    "test:snapshot": "bun test/render-snapshot.ts"
  },
