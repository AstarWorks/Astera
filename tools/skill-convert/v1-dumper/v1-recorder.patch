+    private fun spawnDisplay(f: ProjectileFlight) {
+        val d = f.spec.visual.display ?: return
+        val gw = displays() ?: return
+        val key = d.materialKey.removePrefix("minecraft:")
+        val kind = when (d.variant) {
+            com.astarworks.astera.combat.domain.projectile.DisplayVariant.ITEM_DISPLAY ->
+                com.astarworks.astera.core.domain.effect.DisplayKind.Item(com.astarworks.astera.core.domain.item.ItemId(key.replace('_', '-')))
+            com.astarworks.astera.combat.domain.projectile.DisplayVariant.BLOCK_DISPLAY -> com.astarworks.astera.core.domain.effect.DisplayKind.Block(key)
+            com.astarworks.astera.combat.domain.projectile.DisplayVariant.TEXT_DISPLAY -> return
+        }
+        val spec = com.astarworks.astera.core.domain.effect.DisplaySpec(
+            kind = kind,
+            transform = com.astarworks.astera.core.domain.effect.DisplayTransform(scale = d.scale),
+            lifetimeTicks = 1_000_000L,
+            billboard = com.astarworks.astera.core.domain.effect.DisplayBillboard.valueOf(d.billboard.name),
+        )
+        gw.spawn(com.astarworks.astera.core.domain.world.WorldId("world"), f.position, spec, emptyList())?.let { displayOf[f] = it }
+    }
+
+    /** Mirrors moveDisplay: teleported to the flight point each tick, facing the velocity. */
+    private fun moveDisplay(f: ProjectileFlight) {
+        val h = displayOf[f] ?: return
+        val v = f.velocity
+        val horiz = Math.sqrt(v.x * v.x + v.z * v.z)
+        val yaw = if (horiz == 0.0) 0f else Math.toDegrees(Math.atan2(-v.x, v.z)).toFloat()
+        val pitch = if (horiz == 0.0 && v.y == 0.0) 0f else Math.toDegrees(Math.atan2(-v.y, horiz)).toFloat()
+        displays()?.teleport(h, f.position, yaw, pitch, 1)
+    }
+
+    private fun removeDisplay(f: ProjectileFlight) {
+        val h = displayOf.remove(f) ?: return
+        displays()?.remove(h)
+    }
