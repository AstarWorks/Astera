{
  "_comment": "Astera Shape DSL — pickaxe template (head_handle family). Iron pickaxe head perpendicular to a wooden haft. Load via `bun run studio asdsl load-file <path>` and adjust via `asdsl set-var <name> <value>`.",
  "name": "pickaxe_v1",
  "params": {
    "head_width": 8,
    "head_height": 2.5,
    "head_depth": 2,
    "head_chamfer": 0.5,
    "binding_width": 3,
    "binding_height": 1.2,
    "binding_depth": 2.4,
    "binding_chamfer": 0.2,
    "haft_length": 12,
    "haft_diameter": 1.6
  },
  "textures": {
    "metal_cold": "minecraft:block/iron_block",
    "metal_edge": "minecraft:block/polished_diorite",
    "wood": "minecraft:block/dark_oak_planks",
    "binding": "minecraft:block/copper_block"
  },
  "parts": {
    "head": {
      "kind": "chamfered_cuboid",
      "size": ["@head_width", "@head_height", "@head_depth"],
      "chamfer": "@head_chamfer",
      "axis": "x"
    },
    "binding": {
      "kind": "chamfered_cuboid",
      "size": ["@binding_width", "@binding_height", "@binding_depth"],
      "chamfer": "@binding_chamfer",
      "axis": "y",
      "relative_to": "head",
      "align": "base_center",
      "delta_y": -0.6
    },
    "haft": {
      "kind": "cylinder",
      "axis": "y",
      "length": "@haft_length",
      "diameter": "@haft_diameter",
      "relative_to": "binding",
      "align": "base_center",
      "delta_y": -1.2
    }
  },
  "face_overrides": {},
  "quality": "medium",
  "display": { "gui_rotation_z": 45, "gui_scale": 0.7 }
}
