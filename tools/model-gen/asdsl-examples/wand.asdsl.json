{
  "_comment": "Astera Shape DSL — wand/staff template (orb_shaft family). A magical wand with a gem orb tip, a tapering shaft, and a grip wrap at the base.",
  "name": "wand_v1",
  "params": {
    "orb_diameter": 3,
    "shaft_base_diameter": 0.8,
    "shaft_tip_diameter": 1.6,
    "shaft_length": 10,
    "shaft_segments": 5,
    "grip_length": 3.5,
    "grip_diameter": 1.2,
    "pommel_diameter": 1.4
  },
  "textures": {
    "gem": "minecraft:block/amethyst_block",
    "metal_warm": "minecraft:block/gold_block",
    "wood": "minecraft:block/spruce_planks",
    "leather": "minecraft:block/red_concrete"
  },
  "parts": {
    "orb": {
      "kind": "sphere",
      "diameter": "@orb_diameter"
    },
    "shaft": {
      "kind": "tapered_prism",
      "axis": "y",
      "base_size": ["@shaft_tip_diameter", "@shaft_tip_diameter"],
      "tip_size": ["@shaft_base_diameter", "@shaft_base_diameter"],
      "length": "@shaft_length",
      "segments": "@shaft_segments",
      "tip_style": "flat",
      "cross_section": "octagon",
      "relative_to": "orb",
      "align": "base_center",
      "delta_y": -1.5
    },
    "grip": {
      "kind": "cylinder",
      "axis": "y",
      "length": "@grip_length",
      "diameter": "@grip_diameter",
      "relative_to": "shaft",
      "align": "base_center",
      "delta_y": -0.5
    },
    "pommel": {
      "kind": "sphere",
      "diameter": "@pommel_diameter",
      "relative_to": "grip",
      "align": "base_center",
      "delta_y": -1.2
    }
  },
  "face_overrides": {},
  "quality": "medium",
  "display": { "gui_rotation_z": 45, "gui_scale": 0.6 }
}
