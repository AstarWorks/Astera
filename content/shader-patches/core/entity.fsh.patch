# Astera skin rig (ADR-0250): our own additions to Mojang's core/entity.fsh, applied at pack build time to the
# vanilla shader taken from the client jar (never committed). Format: `@@ before|after|replace: <anchor>`,
# anchor = one whole vanilla line (trimmed), must match exactly once or the pack build fails.
# The body runs to the next `@@` line (or the end of file).
@@ before: #ifndef OIT_ALPHA_ONLY
layout(location = 8) flat in int rigPart;
layout(location = 9) in vec3 rigViewPos;
layout(location = 10) in vec3 rigViewNormal;
layout(location = 11) in vec3 rigCamOffset;

@@ before: vec4 calculateFinalColor(vec4 color) {
// Astera skin rig first-person hiding (ADR-0285, column rule ADR-0293). The server cannot know the client's camera
// perspective, so the rig fades by where it is relative to the camera. In first person the camera sits at the eye and
// the player's own body is a narrow column straight BELOW and around it; a third-person (F5) camera is behind / above /
// in front of the body, also when vanilla's camera collision pulls it to ~0.3-1 blocks, and another player's body is
// at least one hitbox (0.6) away. So head, torso and legs fade by HORIZONTAL distance to the camera (world axes, from
// rigCamOffset) inside a vertical window, not by a sphere. Arms hang to the sides and swing in front of the camera:
// they keep a small sphere so the first-person swing still shows.
// Tuning constants (blocks). Head, torso and legs are HARD-cut (no dither band, never translucent): inside the column
// they are discarded, outside they are fully opaque. Radii exceed the bone corner (head 0.35, torso 0.28, leg 0.26) by a
// margin that also covers the rig lagging the camera by a few ticks. The test is per fragment, so it only handles the
// first-person column; a camera INSIDE a bone cube is handled by culling back faces (below), which hides the whole cube
// at once instead of leaving its far inner faces (ADR-0293 round 2).
const float RIG_HEAD_CUT = 0.4;
const float RIG_TORSO_CUT = 0.45;
const float RIG_LEG_CUT = 0.45;
const float RIG_GHOST_NEAR = 0.6;   // ghost bones: sphere around the camera, for every viewer (decorative, may fade near any camera)
const float RIG_GHOST_FAR = 1.5;
const float RIG_ARM_NEAR = 0.15;     // arms: sphere around the camera, they fade more gently so the first-person swing stays visible
const float RIG_ARM_FAR = 0.5;
const float RIG_COLUMN_UP = 0.8;    // the column reaches this far above the camera (the head top is 0.38 above the eye) ...
const float RIG_COLUMN_DOWN = 1.9;  // ... and this far below it for head and torso (hips are 0.87 below); legs have no lower bound

// 4x4 Bayer threshold in (0, 1) for this screen pixel.
float rigBayer(vec2 fragCoord) {
    ivec2 p = ivec2(mod(fragCoord, 4.0));
    int i = p.x + p.y * 4;
    int m[16] = int[16](0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5);
    return (float(m[i]) + 0.5) / 16.0;
}

// Astera skin rig (ADR-0250): a rig display is drawn with the vanilla player-head cube, whose UVs lie in the
// head box layout of the 64x64 skin (base layer at u 0..32, hat layer at u 32..64, v 0..16). Each fragment
// finds the face of that 8x8x8 box it lies in and the position inside the face, then samples the same face of
// the bone's own box (texOffs and size below) instead. Returns (-1, -1) for fragments outside the layout.
vec2 rigRemap(vec2 uv, int part) {
    int bone = part & 7;
    bool slim = (part & 8) != 0;
    vec2 px = uv * 64.0;
    bool outer = px.x >= 32.0;
    float lu = px.x - (outer ? 32.0 : 0.0);
    float v = px.y;
    if (lu < 0.0 || lu >= 32.0 || v < 0.0 || v >= 16.0) {
        return vec2(-1.0);
    }

    // Source face: 0 top, 1 bottom, 2 right, 3 front, 4 left, 5 back, plus the 0..1 position inside it.
    int face;
    vec2 f;
    if (v < 8.0) {
        if (lu >= 8.0 && lu < 16.0) {
            face = 0;
            f = vec2(lu - 8.0, v) / 8.0;
        } else if (lu >= 16.0 && lu < 24.0) {
            face = 1;
            f = vec2(lu - 16.0, v) / 8.0;
        } else {
            return vec2(-1.0);
        }
    } else {
        int column = int(floor(lu / 8.0));
        face = 2 + column;
        f = vec2(lu - float(column) * 8.0, v - 8.0) / 8.0;
    }

    // Target box: texOffs (skin pixels) and size (width, height, depth).
    vec2 offs;
    vec3 size;
    if (bone == 0) {
        offs = outer ? vec2(32.0, 0.0) : vec2(0.0, 0.0);
        size = vec3(8.0, 8.0, 8.0);
    } else if (bone == 1) {
        offs = outer ? vec2(16.0, 32.0) : vec2(16.0, 16.0);
        size = vec3(8.0, 12.0, 4.0);
    } else if (bone == 2) {
        offs = outer ? vec2(40.0, 32.0) : vec2(40.0, 16.0);
        size = vec3(slim ? 3.0 : 4.0, 12.0, 4.0);
    } else if (bone == 3) {
        offs = outer ? vec2(48.0, 48.0) : vec2(32.0, 48.0);
        size = vec3(slim ? 3.0 : 4.0, 12.0, 4.0);
    } else if (bone == 4) {
        offs = outer ? vec2(0.0, 32.0) : vec2(0.0, 16.0);
        size = vec3(4.0, 12.0, 4.0);
    } else {
        offs = outer ? vec2(0.0, 48.0) : vec2(16.0, 48.0);
        size = vec3(4.0, 12.0, 4.0);
    }
    float w = size.x;
    float h = size.y;
    float d = size.z;

    vec2 origin;
    vec2 extent;
    if (face == 0) {
        origin = vec2(d, 0.0);
        extent = vec2(w, d);
    } else if (face == 1) {
        origin = vec2(d + w, 0.0);
        extent = vec2(w, d);
    } else if (face == 2) {
        origin = vec2(0.0, d);
        extent = vec2(d, h);
    } else if (face == 3) {
        origin = vec2(d, d);
        extent = vec2(w, h);
    } else if (face == 4) {
        origin = vec2(d + w, d);
        extent = vec2(d, h);
    } else {
        origin = vec2(2.0 * d + w, d);
        extent = vec2(w, h);
    }
    return (offs + origin + clamp(f, 0.001, 0.999) * extent) / 64.0;
}

@@ replace: vec4 color = texture(Sampler0, texCoord0);
    vec2 skinUV = texCoord0;
    if (rigPart >= 0) {
        int rigBone = rigPart & 7;
        if (rigPart < 16 && dot(rigViewNormal, rigViewPos) > 0.0) {
            discard;   // back face: the camera is inside this cube (the vanilla pipeline does not cull these)
        }
        float rigVisible;
        if (rigPart >= 16) {
            rigVisible = clamp((length(rigViewPos) - RIG_GHOST_NEAR) / (RIG_GHOST_FAR - RIG_GHOST_NEAR), 0.0, 1.0);
        } else if (rigBone == 2 || rigBone == 3) {
            rigVisible = clamp((length(rigViewPos) - RIG_ARM_NEAR) / (RIG_ARM_FAR - RIG_ARM_NEAR), 0.0, 1.0);
        } else {
            bool rigLeg = rigBone >= 4;
            float rigCut = rigBone == 0 ? RIG_HEAD_CUT : (rigLeg ? RIG_LEG_CUT : RIG_TORSO_CUT);
            bool rigInColumn = length(rigCamOffset.xz) < rigCut && rigCamOffset.y < RIG_COLUMN_UP
                && (rigLeg || rigCamOffset.y > -RIG_COLUMN_DOWN);
            rigVisible = rigInColumn ? 0.0 : 1.0;
        }
        if (rigVisible <= rigBayer(gl_FragCoord.xy) * 0.999) {
            discard;
        }
        skinUV = rigRemap(texCoord0, rigPart);
        if (skinUV.x < 0.0) {
            discard;
        }
    }
    vec4 color = texture(Sampler0, skinUV);

@@ after: color *= faceVertexColor * ColorModulator;
    // Ghost bone (ADR-0284): a tinted, translucent afterimage. The look is fixed here (SkinRigMarker.GHOST_TINT_RGB / GHOST_OPACITY):
    // the skin's shading keeps the body readable, its hue goes to the tint, and the alpha is what the translucent pipeline blends.
    if (rigPart >= 16) {
        float ghostLuma = dot(color.rgb, vec3(0.2126, 0.7152, 0.0722));
        // Hard luma contrast keeps the face, hair, clothes and per-face shading readable inside the violet, so the copy reads as a body.
        color.rgb = clamp(vec3(0.5412, 0.3608, 1.0) * (0.15 + 1.9 * ghostLuma), 0.0, 1.0);
        // Soft glowing edge: faces that look straight at the camera are the thinnest (fade toward the middle), grazing faces carry a
        // brighter rim, so the silhouette glows instead of reading as a flat plate. Mean opacity stays ~GHOST_OPACITY.
        float ghostFacing = clamp(abs(dot(normalize(rigViewNormal), normalize(-rigViewPos))), 0.0, 1.0);
        float ghostRim = 1.0 - ghostFacing;
        color.rgb = mix(color.rgb, vec3(0.78, 0.66, 1.0), 0.55 * ghostRim);
        color.a *= mix(0.38, 0.8, ghostRim);
    }
