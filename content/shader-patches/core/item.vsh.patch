# Astera weapon shading (ADR-0253): our own additions to Mojang's core/item.vsh, applied at pack build time to the
# vanilla shader taken from the client jar (never committed). Format: `@@ before|after|replace: <anchor>`,
# anchor = one whole vanilla line (trimmed), must match exactly once or the pack build fails.
# The body runs to the next `@@` line (or the end of file).
# Block displays and held items both draw through this shader (item_cutout / item_translucent pipelines) with the
# same fixed-world diffuse light, so a face pointing down gets only the 0.4 ambient term. Two markers select one
# shared rule (vanilla lighting, with downward faces lifted toward 0.62 = the azimuth mean of a side face):
#   - weapon-rig part (block display): brightness override (block 15, sky 14) = light UV (240, 224); lit with sky 15;
#   - held weapon model: constant tint (254, 254, 254) on every face; the colour goes back to white, world light kept.
# Rig and held item therefore shade identically in every pose: the hand-over cannot pop.
@@ replace: vertexColor = minecraft_mix_light(Light0_Direction, Light1_Direction, Normal, Color);
    bool asteraWeaponRig = UV2.x == 240 && UV2.y == 224;
    bool asteraWeaponHeld = all(lessThan(abs(Color.rgb - vec3(254.0 / 255.0)), vec3(0.5 / 255.0)));
    vec4 asteraBase = asteraWeaponHeld ? vec4(1.0, 1.0, 1.0, Color.a) : Color;
    vertexColor = minecraft_mix_light(Light0_Direction, Light1_Direction, Normal, asteraBase);
    if (asteraWeaponRig || asteraWeaponHeld) {
        float asteraUnderside = 0.62 * smoothstep(0.2, 0.7, -normalize(Normal).y);
        vertexColor.rgb = max(vertexColor.rgb, asteraBase.rgb * asteraUnderside);
    }

@@ replace: lightMapColor = sample_lightmap(Sampler2, UV2);
    lightMapColor = sample_lightmap(Sampler2, asteraWeaponRig ? ivec2(0, 240) : UV2);
