# Astera skin rig (ADR-0250): our own additions to Mojang's core/entity.vsh, applied at pack build time to the
# vanilla shader taken from the client jar (never committed). Format: `@@ before|after|replace: <anchor>`,
# anchor = one whole vanilla line (trimmed), must match exactly once or the pack build fails.
# The body runs to the next `@@` line (or the end of file).
@@ before: void main() {
// Astera skin rig (ADR-0250). A player_head ItemDisplay with brightness override (block 15, sky = payload)
// is one bone of an animated player body. The server writes payload = bone id (0 head, 1 body, 2 right arm,
// 3 left arm, 4 right leg, 5 left leg) + 8 for a slim arm. -1 = an ordinary entity. entity.fsh remaps the
// head-cube UVs of such a display onto that bone's part of the skin and fades it out near the camera (ADR-0285).
// Ghost bones (ADR-0284, a translucent tinted afterimage) use the codes 6..9 and 12..15: rigPart = bone + 8 if slim + 16 if ghost.
layout(location = 8) flat out int rigPart;
layout(location = 9) out vec3 rigViewPos;

@@ after: void main() {
    rigPart = -1;
    rigViewPos = vec3(0.0);
    if (UV2.x == 240 && (UV2.y & 15) == 0) {
        int sky = UV2.y >> 4;
        if (sky <= 5) {
            rigPart = sky;
        } else if (sky == 6 || sky == 7) {
            rigPart = (sky - 4) + 16;
        } else if (sky == 8 || sky == 9 || sky == 12 || sky == 13) {
            rigPart = (sky - 8) + 16;
        } else if (sky == 10 || sky == 11) {
            rigPart = sky - 8 + 8;
        } else {
            rigPart = (sky - 12) + 8 + 16;
        }
        // Camera-space position, interpolated: the fragment shader fades every rig part (ghosts included) by its distance
        // to the camera (ADR-0285). That replaces the old "drop a head bone enclosing the camera" rule.
        rigViewPos = (ModelViewMat * vec4(Position, 1.0)).xyz;
    }

@@ replace: lightMapColor = sample_lightmap(Sampler2, UV2);
    // Rig displays are lit as if beside a light-15 source, whatever payload their brightness carries.
    lightMapColor = sample_lightmap(Sampler2, rigPart >= 0 ? ivec2(240, 240) : UV2);
