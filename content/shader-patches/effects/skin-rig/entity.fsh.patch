# Astera skin-rig: named hooks from content/shader-patches/hooks.yaml (ADR-0305).
# Shader bodies and marker semantics are preserved from ADR-0275 / ADR-0298.
@@ hook: skin_rig_0
layout(location = 8) flat in int rigPart;
layout(location = 9) in vec3 rigViewPos;
layout(location = 10) in vec3 rigViewNormal;
layout(location = 11) in vec4 rigLightColor;

// rigPart >= 0 is only a light-marker CANDIDATE (ADR-0298): an ordinary entity in a block-14 cell (next to a lantern, torch or
// glowstone) matches it too. A rig is confirmed by its winding: the skinrig item model is mirrored in x, so a rig face that looks
// at the camera is a BACK face to the rasteriser (gl_FrontFacing false) while its normal points at the camera. A real entity's
// front faces always agree with their normals. Set at the top of main(), read by calculateFinalColor.
bool rigConfirmed = false;

@@ hook: skin_rig_1
// Astera skin rig first-person hiding (ADR-0285). The server cannot know the client's camera perspective, so the
// rig fades by distance to the camera instead: the owner's own rig surrounds / touches the first-person camera
// (hidden), a third-person (F5) camera is 3+ blocks away (fully visible), other players' rigs are never this close.
// Tuning constants (blocks): fully discarded below *_NEAR, fully visible from *_FAR, ordered-dither in between.
const float RIG_BODY_NEAR = 0.6;  // head, torso, legs
const float RIG_BODY_FAR = 1.2;
const float RIG_ARM_NEAR = 0.1;   // arms fade more gently so the first-person swing stays visible
const float RIG_ARM_FAR = 0.35;

// 4x4 Bayer threshold in (0, 1) for this screen pixel.
float rigBayer(vec2 fragCoord) {
    ivec2 p = ivec2(mod(fragCoord, 4.0));
    int i = p.x + p.y * 4;
    int m[16] = int[16](0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5);
    return (float(m[i]) + 0.5) / 16.0;
}

// Astera skin rig (ADR-0250): a rig display is drawn with the vanilla player-head cube, whose UVs lie in the
// head box layout of the 64x64 skin (base layer at u 0..32, hat layer at u 32..64, v 0..16). Each fragment
// finds the face of that 8x8x8 box it lies in and the position inside the face, then samples the same face of
// the bone's own box (texOffs and size below) instead. Returns (-1, -1) for fragments outside the layout.
vec2 rigRemap(vec2 uv, int part) {
    int bone = part & 7;
    bool slim = (part & 8) != 0;
    vec2 px = uv * 64.0;
    bool outer = px.x >= 32.0;
    float lu = px.x - (outer ? 32.0 : 0.0);
    float v = px.y;
    if (lu < 0.0 || lu >= 32.0 || v < 0.0 || v >= 16.0) {
        return vec2(-1.0);
    }

    // Source face: 0 top, 1 bottom, 2 right, 3 front, 4 left, 5 back, plus the 0..1 position inside it.
    int face;
    vec2 f;
    if (v < 8.0) {
        if (lu >= 8.0 && lu < 16.0) {
            face = 0;
            f = vec2(lu - 8.0, v) / 8.0;
        } else if (lu >= 16.0 && lu < 24.0) {
            face = 1;
            f = vec2(lu - 16.0, v) / 8.0;
        } else {
            return vec2(-1.0);
        }
    } else {
        int column = int(floor(lu / 8.0));
        face = 2 + column;
        f = vec2(lu - float(column) * 8.0, v - 8.0) / 8.0;
    }

    // The skinrig item model is mirrored in x (ADR-0298), so the geometry shows the mirror image of what this layout says: take the
    // mirror partner of the fragment instead (left and right faces swap, u runs the other way on every face).
    if (face == 2) {
        face = 4;
    } else if (face == 4) {
        face = 2;
    }
    f.x = 1.0 - f.x;

    // Target box: texOffs (skin pixels) and size (width, height, depth).
    vec2 offs;
    vec3 size;
    if (bone == 0) {
        offs = outer ? vec2(32.0, 0.0) : vec2(0.0, 0.0);
        size = vec3(8.0, 8.0, 8.0);
    } else if (bone == 1) {
        offs = outer ? vec2(16.0, 32.0) : vec2(16.0, 16.0);
        size = vec3(8.0, 12.0, 4.0);
    } else if (bone == 2) {
        offs = outer ? vec2(40.0, 32.0) : vec2(40.0, 16.0);
        size = vec3(slim ? 3.0 : 4.0, 12.0, 4.0);
    } else if (bone == 3) {
        offs = outer ? vec2(48.0, 48.0) : vec2(32.0, 48.0);
        size = vec3(slim ? 3.0 : 4.0, 12.0, 4.0);
    } else if (bone == 4) {
        offs = outer ? vec2(0.0, 32.0) : vec2(0.0, 16.0);
        size = vec3(4.0, 12.0, 4.0);
    } else {
        offs = outer ? vec2(0.0, 48.0) : vec2(16.0, 48.0);
        size = vec3(4.0, 12.0, 4.0);
    }
    float w = size.x;
    float h = size.y;
    float d = size.z;

    vec2 origin;
    vec2 extent;
    if (face == 0) {
        origin = vec2(d, 0.0);
        extent = vec2(w, d);
    } else if (face == 1) {
        origin = vec2(d + w, 0.0);
        extent = vec2(w, d);
    } else if (face == 2) {
        origin = vec2(0.0, d);
        extent = vec2(d, h);
    } else if (face == 3) {
        origin = vec2(d, d);
        extent = vec2(w, h);
    } else if (face == 4) {
        origin = vec2(d + w, d);
        extent = vec2(d, h);
    } else {
        origin = vec2(2.0 * d + w, d);
        extent = vec2(w, h);
    }
    return (offs + origin + clamp(f, 0.001, 0.999) * extent) / 64.0;
}

@@ hook: skin_rig_2
    vec2 skinUV = texCoord0;
    if (rigPart >= 0) {
        rigConfirmed = gl_FrontFacing != (dot(rigViewNormal, rigViewPos) < 0.0);
    }
    if (rigConfirmed) {
        int rigBone = rigPart & 7;
        bool rigArm = rigBone == 2 || rigBone == 3;
        float rigNear = rigArm ? RIG_ARM_NEAR : RIG_BODY_NEAR;
        float rigFar = rigArm ? RIG_ARM_FAR : RIG_BODY_FAR;
        float rigVisible = clamp((length(rigViewPos) - rigNear) / (rigFar - rigNear), 0.0, 1.0);
        if (rigVisible <= rigBayer(gl_FragCoord.xy)) {
            discard;
        }
        skinUV = rigRemap(texCoord0, rigPart);
        if (skinUV.x < 0.0) {
            discard;
        }
    }
    vec4 color = texture(Sampler0, skinUV);

@@ hook: skin_rig_3
    // Ghost bone (ADR-0284): a tinted, translucent afterimage. The look is fixed here (SkinRigMarker.GHOST_TINT_RGB / GHOST_OPACITY):
    // the skin's shading keeps the body readable, its hue goes to the tint, and the alpha is what the translucent pipeline blends.
    if (rigConfirmed && rigPart >= 16) {
        float ghostLuma = dot(color.rgb, vec3(0.2126, 0.7152, 0.0722));
        // Hard luma contrast keeps the face, hair, clothes and per-face shading readable inside the violet, so the copy reads as a body.
        color.rgb = clamp(vec3(0.5412, 0.3608, 1.0) * (0.15 + 1.9 * ghostLuma), 0.0, 1.0);
        // Soft glowing edge: faces that look straight at the camera are the thinnest (fade toward the middle), grazing faces carry a
        // brighter rim, so the silhouette glows instead of reading as a flat plate. Mean opacity stays ~GHOST_OPACITY.
        float ghostFacing = clamp(abs(dot(normalize(rigViewNormal), normalize(-rigViewPos))), 0.0, 1.0);
        float ghostRim = 1.0 - ghostFacing;
        color.rgb = mix(color.rgb, vec3(0.78, 0.66, 1.0), 0.55 * ghostRim);
        color.a *= mix(0.38, 0.8, ghostRim);
    }

@@ hook: skin_rig_4
    color *= rigConfirmed ? rigLightColor : lightMapColor;

@@ hook: skin_rig_5
    // A confirmed rig is mirrored, so its camera-facing faces are back faces: shade them as the front faces they are.
    vec4 faceVertexColor = (gl_FrontFacing != rigConfirmed) ? vertexPerFaceColorFront : vertexPerFaceColorBack;
