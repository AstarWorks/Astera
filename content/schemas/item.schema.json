{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://astera.astarworks.com/schemas/item.schema.json",
    "type": "object",
    "properties": {
        "id": {
            "type": "string"
        },
        "material": {
            "type": "string"
        },
        "custom_model_data": {
            "type": "integer"
        },
        "model": {
            "type": "string"
        },
        "external_key": {
            "type": "string"
        },
        "name": {
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        },
        "lore": {
            "type": "object",
            "additionalProperties": {
                "type": "array",
                "items": {
                    "type": "string"
                }
            }
        },
        "role": {
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        },
        "flavor": {
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        },
        "hold": {
            "$ref": "#/definitions/com.astarworks.astera.core.application.config.HoldYaml"
        },
        "rarity": {
            "type": "string"
        },
        "level_requirement": {
            "type": "integer"
        },
        "attributes": {
            "$ref": "#/definitions/com.astarworks.astera.core.application.config.AttributesYaml"
        },
        "equip_slot": {
            "type": "string"
        },
        "max_durability": {
            "type": "integer"
        },
        "unbreakable": {
            "type": "boolean"
        },
        "drop_on_death": {
            "type": "boolean"
        },
        "keep_on_death": {
            "type": "boolean"
        },
        "enchantable": {
            "type": "boolean"
        },
        "glint": {
            "type": "boolean"
        },
        "skills": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/com.astarworks.astera.core.application.config.ItemSkillBindingYaml"
            }
        },
        "pdc_tags": {
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        },
        "tool": {
            "$ref": "#/definitions/com.astarworks.astera.core.application.config.ToolYaml"
        },
        "armor_piece": {
            "type": "string"
        },
        "equipment_asset": {
            "type": "string"
        },
        "resource_type": {
            "type": "string"
        },
        "resource_cost_per_use": {
            "type": "integer"
        },
        "resource_max_pool": {
            "type": "integer"
        },
        "resource_regen_per_second": {
            "type": "number"
        },
        "resource_reloadable": {
            "type": "boolean"
        }
    },
    "required": [
        "id"
    ],
    "definitions": {
        "com.astarworks.astera.core.application.config.AttributesYaml": {
            "type": "object",
            "properties": {
                "attack_damage": {
                    "type": "number"
                },
                "attack_speed": {
                    "type": "number"
                },
                "armor": {
                    "type": "number"
                },
                "armor_toughness": {
                    "type": "number"
                },
                "knockback_resistance": {
                    "type": "number"
                },
                "movement_speed_multiplier": {
                    "type": "number"
                },
                "max_health_bonus": {
                    "type": "number"
                }
            }
        },
        "com.astarworks.astera.core.application.config.HoldYaml": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string"
                },
                "level": {
                    "type": "string"
                },
                "ticks": {
                    "type": "integer"
                }
            },
            "required": [
                "kind"
            ]
        },
        "com.astarworks.astera.core.application.config.ItemSkillBindingYaml": {
            "type": "object",
            "properties": {
                "trigger": {
                    "type": "string"
                },
                "skill_id": {
                    "type": "string"
                },
                "cooldown_override_ticks": {
                    "type": "integer"
                }
            },
            "required": [
                "trigger",
                "skill_id"
            ]
        },
        "com.astarworks.astera.core.application.config.ToolYaml": {
            "type": "object",
            "properties": {
                "class": {
                    "type": "string"
                },
                "tier": {
                    "type": "string"
                }
            },
            "required": [
                "class",
                "tier"
            ]
        }
    }
}