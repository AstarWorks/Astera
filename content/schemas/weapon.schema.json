{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://astera.astarworks.com/schemas/weapon.schema.json",
    "type": "object",
    "properties": {
        "id": {
            "type": "string"
        },
        "display_name_key": {
            "type": "string"
        },
        "lore_key": {
            "type": "string"
        },
        "archetype": {
            "type": "string"
        },
        "rarity": {
            "type": "string"
        },
        "level_requirement": {
            "type": "integer"
        },
        "item": {
            "type": "string"
        },
        "damage": {
            "type": "object",
            "properties": {
                "base": {
                    "type": "number"
                },
                "attribute": {
                    "type": "string"
                }
            },
            "required": [
                "base",
                "attribute"
            ]
        },
        "cooldown_ticks": {
            "type": "integer"
        }
    },
    "required": [
        "id",
        "display_name_key",
        "lore_key",
        "archetype",
        "rarity",
        "level_requirement",
        "item",
        "damage",
        "cooldown_ticks"
    ]
}