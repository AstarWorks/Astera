{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://astera.astarworks.com/schemas/norma.schema.json",
    "type": "object",
    "properties": {
        "id": {
            "type": "string"
        },
        "display_name_key": {
            "type": "string"
        },
        "period": {
            "type": "string"
        },
        "target": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "damage"
                        },
                        "amount": {
                            "type": "integer"
                        }
                    },
                    "required": [
                        "type",
                        "amount"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "kills"
                        },
                        "count": {
                            "type": "integer"
                        }
                    },
                    "required": [
                        "type",
                        "count"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "match_wins"
                        },
                        "count": {
                            "type": "integer"
                        }
                    },
                    "required": [
                        "type",
                        "count"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "xp_gain"
                        },
                        "amount": {
                            "type": "integer"
                        }
                    },
                    "required": [
                        "type",
                        "amount"
                    ]
                }
            ]
        },
        "reward": {
            "type": "object",
            "properties": {
                "currency_id": {
                    "type": "string"
                },
                "currency_amount": {
                    "type": "integer"
                },
                "xp": {
                    "type": "integer"
                }
            }
        }
    },
    "required": [
        "id",
        "display_name_key",
        "period",
        "target",
        "reward"
    ]
}