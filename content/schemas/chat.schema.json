{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://astera.astarworks.com/schemas/chat.schema.json",
    "type": "object",
    "properties": {
        "format": {
            "type": "string"
        },
        "japanize": {
            "$ref": "#/definitions/com.astarworks.astera.chat.application.config.JapanizeConfig"
        },
        "ranks": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/com.astarworks.astera.chat.application.config.ChatRank"
            }
        },
        "discord": {
            "$ref": "#/definitions/com.astarworks.astera.chat.application.config.DiscordConfig"
        },
        "translation": {
            "$ref": "#/definitions/com.astarworks.astera.chat.application.config.TranslationConfig"
        }
    },
    "required": [
        "format",
        "japanize",
        "ranks",
        "discord",
        "translation"
    ],
    "definitions": {
        "com.astarworks.astera.chat.application.config.ChatRank": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "prefix": {
                    "type": "string"
                },
                "suffix": {
                    "type": "string"
                },
                "decoration": {
                    "type": "boolean"
                },
                "priority": {
                    "type": "integer"
                },
                "roles": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "id",
                "prefix",
                "suffix",
                "decoration",
                "priority",
                "roles"
            ]
        },
        "com.astarworks.astera.chat.application.config.DiscordConfig": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "bridge-server": {
                    "type": "string"
                }
            },
            "required": [
                "enabled",
                "bridge-server"
            ]
        },
        "com.astarworks.astera.chat.application.config.JapanizeConfig": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "kanji": {
                    "type": "boolean"
                }
            },
            "required": [
                "enabled",
                "kanji"
            ]
        },
        "com.astarworks.astera.chat.application.config.TranslationConfig": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "languages": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "en",
                            "ja",
                            "ko",
                            "es"
                        ]
                    },
                    "minItems": 1,
                    "uniqueItems": true
                },
                "timeout_ms": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30000
                },
                "marker": {
                    "type": "string"
                },
                "model_profile": {
                    "type": "string",
                    "enum": [
                        "translategemma",
                        "hy-mt",
                        "lfm2"
                    ]
                }
            },
            "required": [
                "enabled",
                "languages",
                "timeout_ms",
                "marker",
                "model_profile"
            ]
        }
    }
}
