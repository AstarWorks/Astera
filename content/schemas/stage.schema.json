{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://astera.astarworks.com/schemas/stage.schema.json",
    "type": "object",
    "properties": {
        "id": {
            "type": "string"
        },
        "display_name_key": {
            "type": "string"
        },
        "regions": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "min": {
                        "type": "object",
                        "properties": {
                            "x": {
                                "type": "number"
                            },
                            "y": {
                                "type": "number"
                            },
                            "z": {
                                "type": "number"
                            }
                        },
                        "required": [
                            "x",
                            "y",
                            "z"
                        ]
                    },
                    "max": {
                        "type": "object",
                        "properties": {
                            "x": {
                                "type": "number"
                            },
                            "y": {
                                "type": "number"
                            },
                            "z": {
                                "type": "number"
                            }
                        },
                        "required": [
                            "x",
                            "y",
                            "z"
                        ]
                    }
                },
                "required": [
                    "min",
                    "max"
                ]
            }
        },
        "spawn_points": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "team": {
                        "type": "string"
                    },
                    "role": {
                        "type": "string"
                    },
                    "position": {
                        "type": "object",
                        "properties": {
                            "x": {
                                "type": "number"
                            },
                            "y": {
                                "type": "number"
                            },
                            "z": {
                                "type": "number"
                            }
                        },
                        "required": [
                            "x",
                            "y",
                            "z"
                        ]
                    },
                    "yaw": {
                        "type": "number"
                    },
                    "pitch": {
                        "type": "number"
                    }
                },
                "required": [
                    "position"
                ]
            }
        },
        "world": {
            "type": "string"
        }
    },
    "required": [
        "id",
        "display_name_key"
    ]
}
