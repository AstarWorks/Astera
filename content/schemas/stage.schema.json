{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://astera.astarworks.com/schemas/stage.schema.json",
    "type": "object",
    "properties": {
        "id": {
            "type": "string"
        },
        "display_name_key": {
            "type": "string"
        },
        "regions": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/com.astarworks.astera.match.application.config.RegionYamlConfig"
            }
        },
        "spawn_points": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/com.astarworks.astera.match.application.config.SpawnPointYamlConfig"
            }
        },
        "pillars": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/com.astarworks.astera.match.application.config.PillarYamlConfig"
            }
        },
        "layout": {
            "$ref": "#/definitions/com.astarworks.astera.match.application.config.ArenaLayoutYamlConfig"
        },
        "warm_slots": {
            "type": "integer"
        }
    },
    "required": [
        "id",
        "display_name_key"
    ],
    "definitions": {
        "com.astarworks.astera.match.application.config.ArenaBridgeYamlConfig": {
            "type": "object",
            "properties": {
                "from": {
                    "type": "string"
                },
                "to": {
                    "type": "string"
                },
                "width": {
                    "type": "integer"
                }
            },
            "required": [
                "from",
                "to"
            ]
        },
        "com.astarworks.astera.match.application.config.ArenaIslandYamlConfig": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "kind": {
                    "type": "string"
                },
                "center": {
                    "$ref": "#/definitions/com.astarworks.astera.match.application.config.ArenaXzYamlConfig"
                },
                "radius": {
                    "type": "number"
                },
                "team": {
                    "type": "string"
                },
                "accent": {
                    "type": "string"
                }
            },
            "required": [
                "id",
                "kind",
                "center",
                "radius"
            ]
        },
        "com.astarworks.astera.match.application.config.ArenaLandmarkYamlConfig": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string"
                },
                "x": {
                    "type": "integer"
                },
                "z": {
                    "type": "integer"
                }
            },
            "required": [
                "kind",
                "x",
                "z"
            ]
        },
        "com.astarworks.astera.match.application.config.ArenaLayoutYamlConfig": {
            "type": "object",
            "properties": {
                "marker_version": {
                    "type": "integer"
                },
                "seed": {
                    "type": "integer"
                },
                "surface_y": {
                    "type": "integer"
                },
                "kill_y": {
                    "type": "integer"
                },
                "islands": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/com.astarworks.astera.match.application.config.ArenaIslandYamlConfig"
                    }
                },
                "bridges": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/com.astarworks.astera.match.application.config.ArenaBridgeYamlConfig"
                    }
                },
                "landmarks": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/com.astarworks.astera.match.application.config.ArenaLandmarkYamlConfig"
                    }
                }
            },
            "required": [
                "seed",
                "islands"
            ]
        },
        "com.astarworks.astera.match.application.config.ArenaXzYamlConfig": {
            "type": "object",
            "properties": {
                "x": {
                    "type": "integer"
                },
                "z": {
                    "type": "integer"
                }
            },
            "required": [
                "x",
                "z"
            ]
        },
        "com.astarworks.astera.match.application.config.PillarYamlConfig": {
            "type": "object",
            "properties": {
                "team": {
                    "type": "string"
                },
                "tier": {
                    "type": "integer"
                },
                "position": {
                    "$ref": "#/definitions/com.astarworks.astera.match.application.config.Vec3YamlConfig"
                },
                "block": {
                    "type": "string"
                },
                "hp": {
                    "type": "integer"
                }
            },
            "required": [
                "team",
                "tier",
                "position",
                "block"
            ]
        },
        "com.astarworks.astera.match.application.config.RegionYamlConfig": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "min": {
                    "$ref": "#/definitions/com.astarworks.astera.match.application.config.Vec3YamlConfig"
                },
                "max": {
                    "$ref": "#/definitions/com.astarworks.astera.match.application.config.Vec3YamlConfig"
                }
            },
            "required": [
                "min",
                "max"
            ]
        },
        "com.astarworks.astera.match.application.config.SpawnPointYamlConfig": {
            "type": "object",
            "properties": {
                "team": {
                    "type": "string"
                },
                "role": {
                    "type": "string"
                },
                "position": {
                    "$ref": "#/definitions/com.astarworks.astera.match.application.config.Vec3YamlConfig"
                },
                "yaw": {
                    "type": "number"
                },
                "pitch": {
                    "type": "number"
                }
            },
            "required": [
                "position"
            ]
        },
        "com.astarworks.astera.match.application.config.Vec3YamlConfig": {
            "type": "object",
            "properties": {
                "x": {
                    "type": "number"
                },
                "y": {
                    "type": "number"
                },
                "z": {
                    "type": "number"
                }
            },
            "required": [
                "x",
                "y",
                "z"
            ]
        }
    }
}