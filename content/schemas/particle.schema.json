{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://astera.astarworks.com/schemas/particle.schema.json",
    "type": "object",
    "properties": {
        "id": {
            "type": "string"
        },
        "particle": {
            "type": "string"
        },
        "count": {
            "type": "integer"
        },
        "offset": {
            "type": "array",
            "items": {
                "type": "number"
            }
        },
        "extra": {
            "type": "number"
        },
        "color": {
            "type": "string"
        },
        "to_color": {
            "type": "string"
        },
        "size": {
            "type": "number"
        },
        "block": {
            "type": "string"
        },
        "item": {
            "type": "string"
        },
        "power": {
            "type": "number"
        },
        "roll": {
            "type": "number"
        },
        "delay": {
            "type": "integer"
        },
        "toward": {
            "type": "boolean"
        },
        "target_offset": {
            "type": "array",
            "items": {
                "type": "number"
            }
        },
        "duration": {
            "type": "integer"
        },
        "arrival_ticks": {
            "type": "integer"
        },
        "shape": {
            "$ref": "#/definitions/com.astarworks.astera.core.application.config.ShapeDto"
        },
        "velocity": {
            "$ref": "#/definitions/com.astarworks.astera.core.application.config.ParticleVelocityDto"
        },
        "display_name_key": {
            "type": "string"
        },
        "force": {
            "type": "boolean"
        },
        "viewers": {
            "type": "string"
        }
    },
    "required": [
        "id",
        "particle"
    ],
    "definitions": {
        "com.astarworks.astera.core.application.config.ParticleVelocityDto": {
            "type": "object",
            "properties": {
                "direction": {
                    "type": "string"
                },
                "custom": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "speed": {
                    "type": "number"
                },
                "spread_degrees": {
                    "type": "number"
                },
                "speed_jitter": {
                    "type": "number"
                }
            },
            "required": [
                "direction"
            ]
        },
        "com.astarworks.astera.core.application.config.ShapeDto": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string"
                },
                "length_blocks": {
                    "type": "number"
                },
                "radius_blocks": {
                    "type": "number"
                },
                "points": {
                    "type": "integer"
                },
                "from_deg": {
                    "type": "number"
                },
                "to_deg": {
                    "type": "number"
                },
                "height_blocks": {
                    "type": "number"
                },
                "turns": {
                    "type": "number"
                }
            },
            "required": [
                "kind"
            ]
        }
    }
}