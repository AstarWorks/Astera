{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://astera.astarworks.com/schemas/particle.schema.json",
    "type": "object",
    "properties": {
        "id": {
            "type": "string"
        },
        "shape": {
            "$ref": "#/definitions/com.astarworks.astera.core.application.config.ShapeDto"
        },
        "color": {
            "$ref": "#/definitions/com.astarworks.astera.core.application.config.ColorDto"
        },
        "count": {
            "type": "integer"
        },
        "lifetime_ticks": {
            "type": "integer"
        },
        "display_name_key": {
            "type": "string"
        },
        "vanilla_particle": {
            "type": "string"
        },
        "speed": {
            "type": "number"
        },
        "size": {
            "type": "number"
        }
    },
    "required": [
        "id",
        "shape",
        "color",
        "count",
        "lifetime_ticks"
    ],
    "definitions": {
        "com.astarworks.astera.core.application.config.ColorDto": {
            "type": "object",
            "properties": {
                "r": {
                    "type": "integer"
                },
                "g": {
                    "type": "integer"
                },
                "b": {
                    "type": "integer"
                }
            },
            "required": [
                "r",
                "g",
                "b"
            ]
        },
        "com.astarworks.astera.core.application.config.ShapeDto": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string"
                },
                "length_blocks": {
                    "type": "number"
                },
                "radius_blocks": {
                    "type": "number"
                },
                "spread_blocks": {
                    "type": "number"
                }
            },
            "required": [
                "kind"
            ]
        }
    }
}