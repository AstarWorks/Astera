{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://astera.astarworks.com/schemas/particle.schema.json",
    "type": "object",
    "properties": {
        "id": {
            "type": "string"
        },
        "shape": {
            "$ref": "#/definitions/com.astarworks.astera.core.application.config.ShapeDto"
        },
        "color": {
            "$ref": "#/definitions/com.astarworks.astera.core.application.config.ColorDto"
        },
        "count": {
            "type": "integer"
        },
        "lifetime_ticks": {
            "type": "integer"
        },
        "display_name_key": {
            "type": "string"
        },
        "vanilla_particle": {
            "type": "string"
        },
        "speed": {
            "type": "number"
        },
        "size": {
            "type": "number"
        },
        "data": {
            "$ref": "#/definitions/com.astarworks.astera.core.application.config.ParticleDataDto"
        },
        "velocity": {
            "$ref": "#/definitions/com.astarworks.astera.core.application.config.ParticleVelocityDto"
        },
        "force": {
            "type": "boolean"
        },
        "viewers": {
            "type": "string"
        }
    },
    "required": [
        "id",
        "shape",
        "color",
        "count",
        "lifetime_ticks"
    ],
    "definitions": {
        "com.astarworks.astera.core.application.config.ColorDto": {
            "type": "object",
            "properties": {
                "r": {
                    "type": "integer"
                },
                "g": {
                    "type": "integer"
                },
                "b": {
                    "type": "integer"
                }
            },
            "required": [
                "r",
                "g",
                "b"
            ]
        },
        "com.astarworks.astera.core.application.config.ParticleDataDto": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string"
                },
                "color": {
                    "$ref": "#/definitions/com.astarworks.astera.core.application.config.ColorDto"
                },
                "from": {
                    "$ref": "#/definitions/com.astarworks.astera.core.application.config.ColorDto"
                },
                "to": {
                    "$ref": "#/definitions/com.astarworks.astera.core.application.config.ColorDto"
                },
                "scale": {
                    "type": "number"
                },
                "power": {
                    "type": "number"
                },
                "block": {
                    "type": "string"
                },
                "item": {
                    "type": "string"
                },
                "target_offset": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "toward": {
                    "type": "boolean"
                },
                "duration_ticks": {
                    "type": "integer"
                },
                "arrival_ticks": {
                    "type": "integer"
                },
                "roll": {
                    "type": "number"
                },
                "delay": {
                    "type": "integer"
                }
            },
            "required": [
                "kind"
            ]
        },
        "com.astarworks.astera.core.application.config.ParticleVelocityDto": {
            "type": "object",
            "properties": {
                "direction": {
                    "type": "string"
                },
                "custom": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "speed": {
                    "type": "number"
                },
                "spread_degrees": {
                    "type": "number"
                }
            },
            "required": [
                "direction"
            ]
        },
        "com.astarworks.astera.core.application.config.ShapeDto": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string"
                },
                "length_blocks": {
                    "type": "number"
                },
                "radius_blocks": {
                    "type": "number"
                },
                "spread_blocks": {
                    "type": "number"
                },
                "points": {
                    "type": "integer"
                },
                "from_deg": {
                    "type": "number"
                },
                "to_deg": {
                    "type": "number"
                },
                "height_blocks": {
                    "type": "number"
                },
                "turns": {
                    "type": "number"
                }
            },
            "required": [
                "kind"
            ]
        }
    }
}