{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://astera.astarworks.com/schemas/anomaly.schema.json",
    "type": "object",
    "properties": {
        "stage_id": {
            "type": "string"
        },
        "anomalies": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "enum": [
                            "resource_spike",
                            "status_burst",
                            "spawn_surge",
                            "time_warp",
                            "gravity_shift",
                            "fog_of_war"
                        ]
                    },
                    "weight": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "duration_seconds": {
                        "type": "number",
                        "exclusiveMinimum": 0
                    },
                    "attribute_key": {
                        "type": "string",
                        "pattern": "^[a-z]+(\\.[a-z0-9_]+)+$"
                    },
                    "operation": {
                        "type": "string",
                        "enum": [
                            "ADD",
                            "MULTIPLY",
                            "SET"
                        ]
                    },
                    "value": {
                        "type": "number"
                    }
                },
                "required": [
                    "type",
                    "weight",
                    "duration_seconds",
                    "attribute_key",
                    "operation",
                    "value"
                ]
            }
        }
    },
    "required": [
        "stage_id",
        "anomalies"
    ]
}
