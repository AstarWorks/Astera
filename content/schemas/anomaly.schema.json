{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://astera.astarworks.com/schemas/anomaly.schema.json",
    "type": "object",
    "properties": {
        "stage_id": {
            "type": "string"
        },
        "anomalies": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/com.astarworks.astera.match.application.config.AnomalyYamlConfig"
            }
        }
    },
    "required": [
        "stage_id"
    ],
    "definitions": {
        "com.astarworks.astera.match.application.config.AnomalyYamlConfig": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string"
                },
                "weight": {
                    "type": "integer"
                },
                "duration_seconds": {
                    "type": "number"
                },
                "attribute_key": {
                    "type": "string"
                },
                "operation": {
                    "type": "string"
                },
                "value": {
                    "type": "number"
                }
            },
            "required": [
                "type",
                "weight",
                "duration_seconds",
                "attribute_key",
                "operation",
                "value"
            ]
        }
    }
}