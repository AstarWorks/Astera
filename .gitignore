# --- JVM / Java ---
*.class
hs_err_pid*
replay_pid*

# --- Logs ---
*.log

# --- Build artifacts ---
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# --- Gradle ---
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
out/
bin/

# --- Kotlin ---
*.kotlin_module
.kotlin/

# --- KSP / annotation processor generated ---
generated/
# ...except the committed procedural item icons (ADR-0193, :tools:item-art)
!content/textures/generated/
!content/models/generated/
!content/particle-skins/generated/
**/build/generated/

# --- IntelliJ IDEA ---
.idea/
*.iml
*.iws
*.ipr

# --- VS Code ---
.vscode/
*.code-workspace

# --- macOS / Linux / Windows ---
.DS_Store
Thumbs.db
desktop.ini

# --- Local env / secrets ---
.env
.env.local
*.local.*
local.properties

# --- Test reports / coverage ---
test-results/
test-output/
*.exec
.kotlin/

# --- BlueJ (legacy from RTM gitignore) ---
*.ctxt

# --- J2ME (legacy) ---
.mtj.tmp/

# --- Paper / Minecraft server runtime (for local dev) ---
# Root-anchored so `core/domain/world/` and similar Kotlin packages aren't ignored.
run/
plugins/
/world/
/world_nether/
/world_the_end/
banned-*.json
ops.json
whitelist.json
usercache.json
server.properties
eula.txt
permissions.yml
help.yml
bukkit.yml
spigot.yml
paper-global.yml
paper-world-defaults.yml
commands.yml
version_history.json
cache/
crash-reports/
libraries/
versions/

# --- Astera-specific ---
# (private/ is a git submodule; do NOT ignore it. See .gitmodules.)

# Top-level iteration PNG artifacts (AsteraStudio scratch when it drops
# screenshots into the project root). Never belong in git.
/*.png

# Playwright MCP scratch — captured for AI vision review, not source.
.playwright-mcp/

# --- Claude Code harness state ---
# Per-session scratch (konsist-watcher dirty tracking, etc.). Settings,
# hooks, rules, agents, and skills under .claude/ ARE committed.
.claude/state/*
!.claude/state/.gitkeep
.claude/scheduled_tasks.lock

# Python bytecode
__pycache__/
*.pyc
