# Build outputs
**/build/
**/.gradle/
**/.kotlin/
**/out/
**/bin/

# IDE / editor
**/.idea/
**/.vscode/
**/*.iml
**/.DS_Store

# VCS
.git/
.gitignore
.github/

# Local env
**/.env
**/.env.*
!**/.env.example

# Docker artefacts themselves don't need to enter the build context
docker/*
!docker/paper-patches
!docker/e2e-tune-content.sh
!docker/folia-patches
!docker/server-type-start.sh

# Docs and deploy aren't needed for the jar build
docs/
deploy/
private/
tools/architecture-test/build/

!docker/void-world
!docker/void-world/**

# Tool sources the plugin jars never depend on: editing e2e/vfx/etc. code must not rebuild the jars (settings.gradle.kts only
# needs each tool's build.gradle.kts to configure).
tools/*/src
