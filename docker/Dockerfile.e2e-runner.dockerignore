# Build outputs
**/build/
**/.gradle/
**/.kotlin/
**/out/
**/bin/

# IDE / editor
**/.idea/
**/.vscode/
**/*.iml
**/.DS_Store

# VCS
.git/
.gitignore
.github/

# Local env
**/.env
**/.env.*
!**/.env.example

# Docker artefacts themselves don't need to enter the build context
docker/*
!docker/paper-patches
!docker/e2e-tune-content.sh

# Docs and deploy aren't needed for the jar build
docs/
deploy/
private/
tools/architecture-test/build/

# Only tools/e2e and tools/bot-runner are built here; other tool sources must not invalidate the compile layer.
tools/*/src
!tools/e2e/src
!tools/bot-runner/src
